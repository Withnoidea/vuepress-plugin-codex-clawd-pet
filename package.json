{
  "name": "vuepress-plugin-codex-clawd-pet",
  "version": "0.1.0",
  "description": "Engine-free SVG/WebP desktop pets for VuePress 2 and vanilla websites",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./themes/*": "./dist/themes/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/generate-pet.mjs",
    "docs:build": "npm run build && vuepress build tests/vuepress --clean-cache --clean-temp",
    "prepack": "npm run build",
    "format": "prettier --write src playground tests test scripts *.json *.ts *.md .github",
    "format:check": "prettier --check src playground tests test scripts *.json *.ts *.md .github",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@vuepress/client": "^2.0.0-rc.31",
    "@vuepress/core": "^2.0.0-rc.31",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vuepress/core": {
      "optional": true
    },
    "@vuepress/client": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/client": "2.0.0-rc.31",
    "@vuepress/core": "2.0.0-rc.31",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "sharp": "^0.34.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.0",
    "vuepress": "2.0.0-rc.31"
  }
}
